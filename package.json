  "repository": {
    "type": "git",
    "url": "https://github.com/javajack/astro-starlight-docs-template.git"
  },
  "bugs": {
    "url": "https://github.com/javajack/astro-starlight-docs-template/issues"
  },
  "homepage": "https://github.com/javajack/astro-starlight-docs-template#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
